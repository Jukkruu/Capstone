# ─── Database (Supabase PostgreSQL) ──────────────────────────────────────────
# Direct connection for Railway/local server (port 5432)
DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECTREF.supabase.co:5432/postgres"

# ─── NestJS API (apps/api) ────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
JWT_SECRET="change-this-to-a-random-secret-at-least-32-chars"
JWT_EXPIRES_IN="7d"
# Comma-separated list of allowed frontend origins
CORS_ORIGIN="http://localhost:3000,https://YOUR-APP.vercel.app"

# ─── Next.js Frontend (apps/web) ─────────────────────────────────────────────
NEXTAUTH_URL="https://YOUR-APP.vercel.app"
NEXTAUTH_SECRET="change-this-to-a-random-secret-at-least-32-chars"
NEXT_PUBLIC_API_URL="https://YOUR-API.railway.app"

# ─── Supabase Storage (file uploads) ─────────────────────────────────────────
SUPABASE_URL="https://PROJECTREF.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_BUCKET="erma-documents"
