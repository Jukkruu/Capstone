{
  "name": "erma-supplier-portal",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w apps/web\" \"npm run dev -w apps/api\"",
    "build": "npm run build -w packages/database && npm run build -w apps/api && npm run build -w apps/web",
    "db:generate": "npm run db:generate -w packages/database",
    "db:migrate": "npm run db:migrate -w packages/database",
    "db:studio": "npm run db:studio -w packages/database",
    "db:seed": "npm run db:seed -w packages/database"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
